ANTHROPIC_API_KEY=
# Long random string: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
RECOGNIZE_MODEL=claude-sonnet-5-5
RECOGNIZE_EFFORT=low
REVIEW_MODEL=claude-opus-5-5
REVIEW_EFFORT=medium
DEFAULT_DAILY_LIMIT_USD=0.30
MONTHLY_LIMIT_USD=15
TIMEZONE=Europe/Berlin

# Weekly DB backup to Telegram via tg-assistant's bot (scripts/backup.sh). Empty = local copies only.
BACKUP_TG_CHAT_ID=

# Push reminders: `python -m scripts.vapid` prints both keys. Subject: a contact for the
# push services, mailto: or https:. Empty keys = no push and no reminder loop.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Coach chat: model, effort and a per-user daily message cap (the $ limits apply too).
COACH_MODEL=claude-opus-5-5
COACH_EFFORT=low
COACH_DAILY_MESSAGES=25
